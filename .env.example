# ---------------------------------------------------------------------------
# Variables d'environnement — copier vers `.env` puis remplir les valeurs.
# ---------------------------------------------------------------------------

# URL HTTP du déploiement Convex (donnée par `npx convex dev`)
# Exemple : https://lovely-mammal-123.convex.cloud
VITE_CONVEX_URL=""

# URL Convex côté serveur (souvent identique à VITE_CONVEX_URL)
CONVEX_URL=""

# Site URL utilisé par BetterAuth (cookies + redirection OAuth)
# En dev : http://localhost:3000
SITE_URL="http://localhost:3000"

# URL publique du site exposée au bundle Vite. Utilisée par getPublicUrl() côté SSR
# pour construire og:url, og:image et les liens partagés (WhatsApp, Facebook, etc.).
# Doit être HTTPS en prod pour que les crawlers WhatsApp/OG fonctionnent.
VITE_SITE_URL="http://localhost:3000"

# Secret BetterAuth (>= 32 caractères). Génère avec : openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Optionnel — OAuth Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
